# Copy to tests/.env and fill in real values, then:
#   pytest tests/test_live.py
# (tests/.env is gitignored; values can also come from the process environment)

# ---- FortiDAST ----
# The FortiDAST username whose assets Get Assets lists (allassets
# requires it; leave unset to try admin/administrator).
# FORTIDAST_USER=admin
# API base URL including the /api suffix. On-premises deployments differ.
FORTIDAST_BASE_URL=https://fortidast.forticloud.com/api

# FortiDAST API key, generated in the console (Vulnerability Assessment > REST
# API). Basic keys cover the read-only smoke tests; privileged keys also allow
# the start/stop scan test.
FORTIDAST_API_KEY=

# FortiDAST lab deployments usually ship a self-signed certificate.
FORTIDAST_VERIFY_SSL=false

# Set to true to allow the mutating test (starts and stops a scan on an asset
# registered in FortiDAST).
FORTIDAST_ALLOW_MUTATE=
